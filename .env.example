# Copy this file to .env and fill in real values. Never commit .env.

# Database (Neon). DATABASE_URL = pooled string (host has -pooler). DIRECT_URL = direct string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Security. Generate each with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="64-hex-characters"
JWT_SECRET="at-least-32-characters"
CRON_SECRET="at-least-16-characters"
# Which camp this SafeVoice site serves (the Camp id in the database)
DEFAULT_CAMP_ID="demo-camp"

# Audio storage (Supabase Storage, S3-compatible)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# AI pipeline (Groq). Change the model names here if a provider retires one.
CLOUDFLARE_ACCOUNT_ID=""
AI_API_KEY=""